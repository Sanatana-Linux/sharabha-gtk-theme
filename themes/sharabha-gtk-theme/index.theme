[Desktop Entry]
Type=X-GNOME-Metatheme
Name=sharabha-gtk-theme
Comment=Skeuomorphic GTK theme based on the Sanatana Linux color palette
Encoding=UTF-8

[GNOME Shell]
ShellTheme=sharabha-gtk-theme

[GTK 2.0]
GtkTheme=sharabha-gtk-theme

[GTK 3.0]
GtkTheme=sharabha-gtk-theme
MetacityTheme=sharabha-gtk-theme

[GTK 4.0]
GtkTheme=sharabha-gtk-theme

[Xfce]
Xfwm4Theme=sharabha-gtk-theme