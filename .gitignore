# OpenCode ephemeral session state & caches
# (Durable knowledge under .opencode/context/ is intentionally tracked.)
.opencode/state/
.opencode/cache/

# Nix build output symlinks (created by `nix build`)
result
result-*

# Released theme bundle assembled by GitHub Actions
# Cached build artifacts — regenerated on each CI run, not source-tracked.
release/

# ImageMagick-generated PNG fallbacks for xfwm4
# Sources are the tracked .svg siblings; PNGs are regenerated by the build step
# (parse-sass.sh + ImageMagick in the Nix flake buildPhase).
src/main/xfwm4/*.png
themes/**/xfwm4/*.png

# Editor / OS cruft
*~
.*.swp
.*.swo
.DS_Store
Thumbs.db
desktop.ini

# Python / tooling caches
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# Loose archives (not part of source tree)
*.tar.gz
*.zip